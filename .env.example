# Copy to .env (never commit). host/setup.sh generates random secrets for the blanks.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
LITELLM_MASTER_KEY=
AGENT_JWT_SECRET=            # same value in ~/nodeReact .env (GET /api/agent-token)
HARNESS_TOKEN=               # also written to ~/.config/harness/token for host scripts/hooks
OWNER_ID=owner               # must equal the `sub` nodeReact puts in the JWT

# Router
TYPESAFE_API_KEY=

# Models (LiteLLM aliases → real models)
LOCAL_MODEL=ollama_chat/qwen3.5:9b
CLOUD_FAST_MODEL=openai/gpt-6-luna
CLOUD_STRONG_MODEL=anthropic/claude-sonnet-5-5
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Knowledge base (phase 10): read-only docs folder indexed for RAG
DOCS_DIR=/home/hoder/agent-docs

# Copilot ingest (phase 6): host Copilot session folder, mounted read-only at /copilot-sessions
COPILOT_SESSIONS_DIR=/home/hoder/.copilot/session-state

# Tools
BRAVE_API_KEY=               # web_search tool (https://brave.com/search/api/)

# LINE (phase 8)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_OWNER_USER_ID=

# Coding route (phase 5, §9a)
SANDBOX_ROOT=/home/hoder/agent-sandboxes   # host dir for task clones; mounted at the same path in sandbox-manager
COPILOT_GITHUB_TOKEN=        # fine-grained PAT with only "Copilot Requests"; given only to copilot sandboxes
